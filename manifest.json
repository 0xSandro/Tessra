{
  "manifest_version": 2,
  "name": "Tessra - Custom Starting Page",
  "short_name": "Tessra",
  "version": "1.0.0",
  "description": "A fast, private new-tab dashboard: drag and drop 50+ widgets (weather, crypto, GitHub, to-dos, and more) onto a fully themeable board. No account, no tracking.",
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "tabs",
    "history",
    "bookmarks",
    "sessions",
    "topSites",
    "notifications",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.coingecko.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://gamma-api.polymarket.com/*",
    "https://github-contributions-api.jogruber.de/*",
    "https://speed.cloudflare.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://api.wheretheiss.at/*",
    "https://en.wikipedia.org/*",
    "https://api.notion.com/*",
    "https://date.nager.at/*",
    "https://api.alternative.me/*",
    "https://api.github.com/*",
    "https://hn.algolia.com/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self';",
  "browser_specific_settings": {
    "gecko": {
      "id": "tessra@0xsandro.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
